---
import Instruction from "./Instruction.astro";

import { getLangFromUrl, useTranslations } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="container mt-5 bg-subtle-secondary">
    <h3 class="border-bottom pb-1">{t('instructions.title')}</h3>
    <ol class="list-unstyled vstack gap-3 fs-">
        <Instruction number="1" , title={t('instructions.load.title')}>
            <span>{t('instructions.load.description')}</span>
        </Instruction>
        <Instruction number="2" , title={t('instructions.label.title')}>
            <span>{t('instructions.label.description')}</span>
        </Instruction>
        <Instruction number="3" , title={t('instructions.export.title')}>
            <span>{t('instructions.export.description')}
                    <code>{t('instructions.export.description.format')}</code>.</span>
        </Instruction>
    </ol>
</div>
