---
import Feature from "./Feature.astro";

import { getLangFromUrl, useTranslations } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="bg-body-tertiary">
    <div class="container py-5">
        <h3 class="border-bottom pb-1">{t('features.title')}</h3>
        <div
            class="row mt-3 row-cols-lg-4 row-cols-md-2 row-cols-sm-1 row-cols-1"
        >
            <Feature
                iconClass="bi-wallet2"
                title={t('features.free.title')}
                description={t('features.free.description')}
            />
            <Feature
                iconClass="bi-pc-display"
                title={t('features.local.title')}
                description={t('features.local.description')}
            />
            <Feature
                iconClass="bi-command"
                title={t('features.hotkeys.title')}
                description={t('features.hotkeys.description')}
            />
            <Feature
                iconClass="bi-file-earmark"
                title={t('features.export.title')}
                description={t('features.export.description')}
            />
        </div>
    </div>
</div>
