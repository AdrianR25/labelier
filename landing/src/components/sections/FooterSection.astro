---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="bg-body-tertiary mt-5 pt-3 text-body-secondary">
    <div class="container pt-3">
        <div
            class="d-flex flex-column flex-md-row border-bottom justify-content-between"
        >
            <p class="col-md-5">{t('footer.contact.1')}<a href="mailto:adrian@adrianr.dev">{t('footer.contact.cta')}</a>{t('footer.contact.2')}</p>
            <p class="col-md-5">{t('footer.donate')}</p>
        </div>
        <p class="text-center my-3">
            {t('footer.credit')}<a href="https://adrianr.dev">Adrián R</a>
        </p>
    </div>
</footer>
